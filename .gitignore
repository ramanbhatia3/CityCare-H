# ==============================================================================
# CityCare Root .gitignore
# ==============================================================================

# Environment files & Secrets (CRITICAL: Never commit .env files)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Production Builds & Bundles
dist/
dist-ssr/
build/
backend/dist/
frontend/dist/
*.local

# User uploads & ephemeral media
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & IDE directories
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
