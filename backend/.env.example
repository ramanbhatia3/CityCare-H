# ==============================================================================
# CityCare Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Fill in your credentials below.
# 3. NEVER commit your actual .env file to version control.
# ==============================================================================

# MongoDB Connection String:
# - Local MongoDB instance: mongodb://localhost:27017/CityCare
# - MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.mongodb.net/CityCare?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/CityCare?retryWrites=true&w=majority"

# JWT Secret:
# Must be a cryptographically strong random string (min 32 characters).
# Generate a new 256-bit secret via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_string_min_32_chars"

# Server Port (Default: 5000)
PORT=5000

# Gmail SMTP Credentials for OTP Verification & Alerts:
# NOTE: Requires 2-Step Verification enabled on your Google Account.
# Generate a dedicated App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_16_character_app_password"